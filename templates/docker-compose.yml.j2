services:
  # -------------------------------------------------------
  # 1. Traefik - Reverse Proxy & SSL Manager
  # -------------------------------------------------------
  traefik:
    container_name: traefik
    image: traefik:v3.7
    restart: always
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--entrypoints.web.http.redirections.entryPoint.scheme=https"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
    networks:
      - cloud

  # -------------------------------------------------------
  # 2. MariaDB - Database
  # -------------------------------------------------------
  db:
    container_name: mariadb
    image: mariadb:11.8
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: {{ vault_db_root_password }}
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wp_user
      MYSQL_PASSWORD: {{ vault_db_password }}
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - cloud

  # -------------------------------------------------------
  # 3. WordPress - Web Application
  # -------------------------------------------------------
  wordpress:
    container_name: wordpress
    image: wordpress:latest
    restart: always
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: wp_user
      WORDPRESS_DB_PASSWORD: {{ vault_db_password }}
      WORDPRESS_DB_NAME: wordpress
    volumes:
      - wp_data:/var/www/html
    depends_on:
      - db
    networks:
      - cloud
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.wordpress.rule=HostRegexp(`.+`)"
      - "traefik.http.routers.wordpress.entrypoints=websecure"
      - "traefik.http.routers.wordpress.tls=true"
      - "traefik.http.routers.wordpress.priority=1"
      - "traefik.http.services.wordpress.loadbalancer.server.port=80"

  # -------------------------------------------------------
  # 4. phpMyAdmin - Database Management Tool
  # -------------------------------------------------------
  phpmyadmin:
    container_name: phpmyadmin
    image: phpmyadmin:latest
    restart: always
    environment:
      PMA_HOST: db
      PMA_ABSOLUTE_URI: "/pma/"
    depends_on:
      - db
    networks:
      - cloud
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.pma.rule=PathPrefix(`/pma`)"
      - "traefik.http.routers.pma.entrypoints=websecure"
      - "traefik.http.routers.pma.tls=true"
      - "traefik.http.routers.pma.priority=100"
      - "traefik.http.services.pma.loadbalancer.server.port=80"
      - "traefik.http.middlewares.pma-stripprefix.stripprefix.prefixes=/pma"
      - "traefik.http.middlewares.pma-addslash.redirectregex.regex=^(https?://[^/]+/pma)$$"
      - "traefik.http.middlewares.pma-addslash.redirectregex.replacement=$${1}/"
      - "traefik.http.routers.pma.middlewares=pma-addslash,pma-stripprefix"

volumes:
  db_data:
  wp_data:

networks:
  cloud:
    driver: bridge
